# ================================================================================
# PROJECT VATAWARAN — GOVERNMENT APIS & ENVIRONMENT CONFIGURATION
# Ministry of Earth Sciences (MoES) | Smart India Hackathon 2026 | PS ID: 26078
# ================================================================================

# --- 1. NCMRWF Numerical Weather Prediction Ingest ---
# OpenDAP / THREDDS Data Server (TDS) for NEPS-G 12 km Ensemble & NCUM
NCMRWF_THREDDS_URL=https://opendap.ncmrwf.gov.in/thredds/dodsC/NEPSG
NCMRWF_FTP_HOST=ftp.ncmrwf.gov.in
NCMRWF_FTP_USER=anonymous
NCMRWF_FTP_PASSWORD=guest

# --- 2. IMDAA & ERA5 Climatology Baselines ---
# 40-year Indian Monsoon Data Assimilation and Analysis (12 km reanalysis)
IMDAA_CATALOG_URL=https://rds.ncmrwf.gov.in/opendap/IMDAA
# ECMWF Copernicus Climate Data Store (CDS) API key (for ERA5 1991-2020)
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=your-uid:your-copernicus-api-key

# --- 3. IMD Ground Observation & Radar Telemetry ---
# India Meteorological Department (Mausam / OGD API)
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
IMD_API_KEY=your_imd_api_token_here
IMD_DWR_RADAR_ENDPOINT=https://mausam.imd.gov.in/radar/api/dwr-composites

# --- 4. ISRO / MOSDAC Geostationary Satellite Feeds ---
# Space Applications Centre (SAC) Ahmedabad - INSAT-3DR / 3DS
MOSDAC_API_BASE_URL=https://mosdac.gov.in/api/v1
MOSDAC_USER_EMAIL=your_email@domain.com
MOSDAC_TOKEN=your_mosdac_bearer_token

# --- 5. NDMA Sachet CAP v1.2 (Common Alerting Protocol) Gateway ---
# National Disaster Management Authority alert dissemination endpoint
NDMA_SACHET_URL=https://sachet.ndma.gov.in/cap/api/v1
NDMA_SENDER_ID=vatawaran.engine@ncmrwf.gov.in
NDMA_API_TOKEN=your_ndma_sachet_auth_token

# --- 6. Topography & Auxiliary Land Surface Data ---
# NASA Earthdata / OpenTopography for SRTM 30m DEM downsampled to 5 km
EARTHDATA_USERNAME=your_nasa_earthdata_user
EARTHDATA_PASSWORD=your_nasa_earthdata_pass
OPENTOPOGRAPHY_API_KEY=your_opentopo_key

# --- 7. Server Deployment Configuration ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
